# 02_insert_sample.hbase
# Inserts 20 real flight records taken directly from the full 5.8M dataset and verifies with scan

# 1. AS#ANC#20150101#0005#00098#SEA
put 'flights', 'AS#ANC#20150101#0005#00098#SEA', 'info:airline_name', 'Alaska Airlines Inc.'
put 'flights', 'AS#ANC#20150101#0005#00098#SEA', 'info:origin', 'ANC'
